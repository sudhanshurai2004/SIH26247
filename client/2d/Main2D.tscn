text = "2D Training Playback"

[node name="Status" type="Label" parent="Layout/Controls"]
layout_mode = 2
text = "0 ms"

[node name="Play" type="Button" parent="Layout/Controls"]
layout_mode = 2
text = "Play / Pause"

[node name="Timeline" type="HSlider" parent="Layout/Controls"]
layout_mode = 2
max_value = 12000.0
