anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.16, 0.2, 1)
mouse_filter = 2

[node name="Controls" type="VBoxContainer" parent="Layout"]
layout_mode = 0
offset_left = 680.0
offset_right = 1180.0
offset_bottom = 560.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Layout/Controls"]
layout_mode = 2
